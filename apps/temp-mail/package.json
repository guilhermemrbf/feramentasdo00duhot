{
  "name": "@00duhot/temp-mail",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "prisma generate && vite build",
    "dev:web": "vite",
    "start:api": "node src/api.mjs",
    "start:worker": "node src/worker.mjs",
    "start:smtp": "node src/ingest.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node src/seed.mjs",
    "test": "node --test tests/unit.test.mjs",
    "test:integration": "node --test tests/integration.test.mjs",
    "test:e2e": "playwright test",
    "smoke:production": "node scripts/smoke-production.mjs"
  },
  "dependencies": {
    "@fastify/swagger": "^9.7.0",
    "@prisma/client": "6.19.3",
    "bullmq": "6.7.3",
    "fastify": "5.12.8",
    "ioredis": "^5.8.2",
    "mailparser": "3.14.3",
    "nodemailer": "10.5.0",
    "prisma": "6.19.3",
    "sanitize-html": "2.18.1",
    "smtp-server": "3.21.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
