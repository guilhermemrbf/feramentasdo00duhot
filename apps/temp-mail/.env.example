# Gere um .env local com: node scripts/init-env.mjs
POSTGRES_PASSWORD=
MAILBOX_TOKEN_SECRET=
APP_URL=http://localhost:8080
DEFAULT_MAIL_DOMAIN=mail.test
MAILBOX_TTL_HOURS=24
MAX_MESSAGE_SIZE=2097152
MAX_MAILBOX_MESSAGES=100
MAX_MAILBOX_BYTES=20971520
CREATE_PER_HOUR=8
SMTP_HOST=mx.mail.test
# Produção: APP_URL=https://correio.SEUDOMINIO, DEFAULT_MAIL_DOMAIN real, TLS e contato obrigatórios
# ABUSE_CONTACT=
# WEB_HOST=
# TLS_WEB_DIR=
# TLS_SMTP_DIR=
# Seed administrativo: injete temporariamente ADMIN_EMAIL e ADMIN_PASSWORD (16+ caracteres).
# Execução sem Docker também exige DATABASE_URL e REDIS_URL.
