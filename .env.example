# Public Supabase configuration (same project as server configuration)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix secrets with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta Login Unificado. Para outro app Meta, informe a configuração de login
# compatível com contas do Instagram criada no painel da Meta.
META_INSTAGRAM_LOGIN_CONFIG_ID=

# Comma-separated Supabase Auth user UUIDs allowed to use cloud resources.
HOT_PROFILES_ALLOWED_USER_IDS=
# 32 random bytes encoded as 64 hexadecimal characters. Back up securely.
HOT_PROFILES_ENCRYPTION_KEY=

BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
GENYMOTION_API_TOKEN=
# A ready ARM64 recipe belonging/available to your Genymotion account.
GENYMOTION_RECIPE_ID=

# Historical Telegram Sync cloud service (not integrated in the current editor).
# Server only, never VITE_. The local Windows editor requires none of these.
TELEGRAM_SYNC_SERVICE_URL=http://telegram-api:8000
TELEGRAM_DATABASE_URL=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_ENCRYPTION_KEY=

# Public HTTPS origin of the independently hosted Correio Temporário app.
VITE_TEMP_MAIL_URL=
